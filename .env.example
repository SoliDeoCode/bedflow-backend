PORT=4000
NODE_ENV=development

# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production, the server REFUSES to start if this is left as the placeholder or under 32 chars.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed origins. NEVER use * in production.
# Example: CORS_ORIGIN=https://bedflow.example.com,https://app.bedflow.example.com
CORS_ORIGIN=https://bedflow-backend-1.onrender.com

# PostgreSQL (Supabase). Both URL and DIRECT_URL are required by Prisma.
# Get these from: Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@yourhospital.com

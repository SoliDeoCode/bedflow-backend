# ──────────────────────────────────────────────────────────────
# Copy this file to .env.development (dev DB) and .env.production (prod DB)
# Neither file should ever be committed to git.
#
# npm run dev          → NODE_ENV=development → reads .env.development
# npm run start        → NODE_ENV=production  → reads .env.production
# Render (cloud)       → NODE_ENV=production  → reads Render dashboard env vars
# ──────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to start if this is left as the placeholder or under 32 chars.
JWT_SECRET=change-this-to-a-long-random-string

# Allowed origins. Use * for dev, explicit domain(s) for production.
CORS_ORIGIN=*

# PostgreSQL (Supabase).
# Get from: Supabase dashboard → Project Settings → Database → Connection string
# Transaction-mode pooler (used by the app at runtime)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
# Session-mode pooler (used by prisma migrate)
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@yourhospital.com

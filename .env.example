PORT=4000
NODE_ENV=development

# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production, the server REFUSES to start if this is left as the placeholder or under 32 chars.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed origins. NEVER use * in production.
# Example: CORS_ORIGIN=https://bedflow.example.com,https://app.bedflow.example.com
CORS_ORIGIN=*

SQLITE_PATH=

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@yourhospital.com

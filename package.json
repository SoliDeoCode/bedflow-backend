{
  "name": "bedflow-backend",
  "version": "1.0.0",
  "description": "BedFlow hospital bed management — backend API, WebSocket, scheduler",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development node dist/index.js",
    "seed": "cross-env NODE_ENV=development tsx src/db/seed.ts",
    "db:migrate": "cross-env NODE_ENV=development prisma migrate deploy",
    "db:migrate:prod": "cross-env NODE_ENV=production prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "cross-env NODE_ENV=development tsx src/db/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}

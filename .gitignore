# Dependencies — installed by npm on deploy
node_modules/

# Environment secrets — set via Render dashboard, never commit
.env
.env.development
.env.production
.env.*.local

# Compiled output — build fresh on each deploy/clone
dist/

# SQLite database and journal files — not for source control
database/*.db
database/*.db-shm
database/*.db-wal

# OS & editor noise
.DS_Store
*.swp
*.swo

# TypeScript build cache
*.tsbuildinfo
